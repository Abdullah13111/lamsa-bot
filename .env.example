# Copy to .env for local runs. Never commit .env.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Neon connection string. Empty = in-memory storage (history lost on restart).
DATABASE_URL=

# WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp)
WA_VERIFY_TOKEN=any-long-random-string-you-choose
WA_APP_SECRET=
WA_ACCESS_TOKEN=
# WA_GRAPH_VERSION=v23.0
# WA_CLIENT_ID=lamsa

# Comma-separated sites allowed to call /chat
# CORS_ORIGINS=https://lamsa-website-theta.vercel.app,http://localhost:4321

# Password for /admin/bookings (any username)
ADMIN_TOKEN=
